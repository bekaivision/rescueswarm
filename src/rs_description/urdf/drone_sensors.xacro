<?xml version="1.0"?>
<!-- Сенсоры дрона: надирный датчик глубины (облако точек) и надирный тепловизор.
     Отдельный кусок, чтобы его подключали обе модели дрона: лёгкая (drone_light.urdf.xacro)
     и позже X500 для PX4. Подключающий файл должен определить link base_link и свойство ns
     (имя робота), а затем вызвать <xacro:drone_sensors/>.
     Оси сенсоров по правилу камер Gazebo: x = оптическая ось, y влево, z вверх.
     Поворот pitch = +pi/2 направляет ось x строго вниз (надир).
     Кадры: <ns>/depth_link и <ns>/thermal_link (префикс "<ns>/" пишет Gazebo в gz_frame_id,
     тот же префикс добавляет robot_state_publisher). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="depth_rate" default="5"/>
  <xacro:arg name="depth_width" default="160"/>
  <xacro:arg name="depth_height" default="120"/>
  <xacro:arg name="air_thermal_rate" default="5"/>
  <xacro:arg name="air_thermal_width" default="160"/>
  <xacro:arg name="air_thermal_height" default="120"/>

  <xacro:macro name="nadir_link" params="name z">
    <link name="${name}">
      <visual><geometry><box size="0.03 0.03 0.03"/></geometry>
        <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/><child link="${name}"/>
      <origin xyz="0 0 ${z}" rpy="0 1.5707963 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="drone_sensors">
    <xacro:nadir_link name="depth_link" z="-0.08"/>
    <xacro:nadir_link name="thermal_link" z="-0.08"/>

    <!-- Датчик глубины: depth_camera, облако точек в /<ns>/depth/points (сама картинка глубины в /<ns>/depth) -->
    <gazebo reference="depth_link">
      <sensor name="depth" type="depth_camera">
        <always_on>1</always_on>
        <update_rate>$(arg depth_rate)</update_rate>
        <topic>/${ns}/depth</topic>
        <gz_frame_id>${ns}/depth_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image><width>$(arg depth_width)</width><height>$(arg depth_height)</height><format>R_FLOAT32</format></image>
          <clip><near>0.3</near><far>15</far></clip>
        </camera>
      </sensor>
    </gazebo>

    <!-- Тепловизор: та же кодировка L16 (0.01 К на отсчёт), что у наземного робота -->
    <gazebo reference="thermal_link">
      <sensor name="thermal" type="thermal">
        <always_on>1</always_on>
        <update_rate>$(arg air_thermal_rate)</update_rate>
        <topic>/${ns}/thermal/image_raw</topic>
        <gz_frame_id>${ns}/thermal_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image><width>$(arg air_thermal_width)</width><height>$(arg air_thermal_height)</height><format>L16</format></image>
          <clip><near>0.1</near><far>50</far></clip>
        </camera>
      </sensor>
    </gazebo>

    <!-- Истинная поза в мировом кадре, только для оценки. TF уходит в непробрасываемый /gt_tf -->
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>${ns}/base_link</robot_base_frame>
        <odom_topic>/${ns}/gt_odom</odom_topic>
        <tf_topic>/${ns}/gt_tf</tf_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
