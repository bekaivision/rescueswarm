<?xml version="1.0"?>
<!-- Лёгкий дрон (без PX4): простой квадрокоптер ~0.5 м в поперечнике, ~2 кг, с рамой, лучами и винтами.
     Полёт: gz-sim-velocity-control-system (кинематика) при отключённой гравитации.
     Скорость задаётся командой Twist в /<ns>/cmd_vel (мировая система, курс не меняется).
     Почему так: плагин не требует настройки регуляторов, не зависит от шага физики и
     стоит почти ноль CPU; дрон держится на месте при нулевой команде. Динамику квадрокоптера
     и смену поз заменит PX4 (модель X500 с теми же сенсорами из drone_sensors.xacro).
     Сенсоры и gt_odom: drone_sensors.xacro. Имена звеньев простые, префикс "<ns>/" добавляет
     robot_state_publisher. Топики Gazebo: /<robot_name>/... -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="drone_light">
  <xacro:arg name="robot_name" default="drone_1"/>
  <xacro:property name="ns" value="$(arg robot_name)"/>
  <xacro:include filename="$(find rs_description)/urdf/drone_sensors.xacro"/>

  <xacro:macro name="visual_box" params="x y z sx sy sz yaw color">
    <visual><origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/><geometry><box size="${sx} ${sy} ${sz}"/></geometry>
      <material name="m_${x}_${y}_${z}_${sx}"><color rgba="${color}"/></material></visual>
  </xacro:macro>
  <xacro:macro name="rotor" params="x y">
    <visual><origin xyz="${x} ${y} 0.08"/><geometry><cylinder radius="0.11" length="0.008"/></geometry>
      <material name="rotor_${x}_${y}"><color rgba="0.15 0.15 0.15 0.8"/></material></visual>
    <visual><origin xyz="${x} ${y} 0.045"/><geometry><cylinder radius="0.02" length="0.07"/></geometry>
      <material name="motor_${x}_${y}"><color rgba="0.8 0.1 0.1 1"/></material></visual>
  </xacro:macro>

  <!-- Центр тела = центр масс; низ полозьев на z = -0.125, верх винтов около +0.085 (высота ~0.21-0.25) -->
  <link name="base_link">
    <visual><origin xyz="0 0 0.0"/><geometry><box size="0.2 0.2 0.08"/></geometry>
      <material name="body"><color rgba="0.95 0.35 0.05 1"/></material></visual>
    <xacro:visual_box x="0" y="0" z="0.03" sx="0.62" sy="0.035" sz="0.02" yaw="0.7853982" color="0.1 0.1 0.1 1"/>
    <xacro:visual_box x="0" y="0" z="0.03" sx="0.62" sy="0.035" sz="0.02" yaw="-0.7853982" color="0.1 0.1 0.1 1"/>
    <xacro:rotor x="0.22" y="0.22"/>
    <xacro:rotor x="0.22" y="-0.22"/>
    <xacro:rotor x="-0.22" y="0.22"/>
    <xacro:rotor x="-0.22" y="-0.22"/>
    <!-- полозья -->
    <xacro:visual_box x="0" y="0.14" z="-0.12" sx="0.36" sy="0.02" sz="0.01" yaw="0" color="0.1 0.1 0.1 1"/>
    <xacro:visual_box x="0" y="-0.14" z="-0.12" sx="0.36" sy="0.02" sz="0.01" yaw="0" color="0.1 0.1 0.1 1"/>
    <xacro:visual_box x="0.12" y="0.14" z="-0.07" sx="0.015" sy="0.015" sz="0.1" yaw="0" color="0.1 0.1 0.1 1"/>
    <xacro:visual_box x="-0.12" y="0.14" z="-0.07" sx="0.015" sy="0.015" sz="0.1" yaw="0" color="0.1 0.1 0.1 1"/>
    <xacro:visual_box x="0.12" y="-0.14" z="-0.07" sx="0.015" sy="0.015" sz="0.1" yaw="0" color="0.1 0.1 0.1 1"/>
    <xacro:visual_box x="-0.12" y="-0.14" z="-0.07" sx="0.015" sy="0.015" sz="0.1" yaw="0" color="0.1 0.1 0.1 1"/>
    <!-- столкновения: корпус и два полоза (дрон опирается на землю при старте и посадке) -->
    <collision><origin xyz="0 0 0.0"/><geometry><box size="0.2 0.2 0.08"/></geometry></collision>
    <collision><origin xyz="0 0.14 -0.12"/><geometry><box size="0.36 0.02 0.01"/></geometry></collision>
    <collision><origin xyz="0 -0.14 -0.12"/><geometry><box size="0.36 0.02 0.01"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="2.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.04" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <xacro:drone_sensors/>

  <gazebo reference="base_link">
    <gravity>false</gravity>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/${ns}/cmd_vel</topic>
    </plugin>
  </gazebo>
</robot>
