<?xml version="1.0"?>
<!-- Наземный робот: дифф. привод, 3D LiDAR, RGB, тепловизор, IMU.
     Имена звеньев простые (base_link, ...); префикс кадров "ground_N/" добавляет
     robot_state_publisher (frame_prefix), а Gazebo пишет его в frame_id сенсоров и odom.
     Топики Gazebo: /<robot_name>/... -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ground_robot">
  <xacro:arg name="robot_name" default="ground_1"/>
  <xacro:arg name="lidar_rate" default="10"/>
  <xacro:arg name="lidar_samples" default="360"/>
  <xacro:arg name="lidar_beams" default="16"/>
  <xacro:arg name="rgb_rate" default="5"/>
  <xacro:arg name="rgb_width" default="320"/>
  <xacro:arg name="rgb_height" default="240"/>
  <xacro:arg name="thermal_rate" default="5"/>
  <xacro:arg name="thermal_width" default="160"/>
  <xacro:arg name="thermal_height" default="120"/>
  <xacro:arg name="imu_rate" default="50"/>
  <xacro:property name="ns" value="$(arg robot_name)"/>
  <xacro:property name="wr" value="0.08"/>   <!-- радиус колеса -->
  <xacro:property name="ws" value="0.34"/>   <!-- колея -->

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial><mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="small_link" params="name x y z">
    <link name="${name}">
      <visual><geometry><box size="0.04 0.04 0.04"/></geometry>
        <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/><child link="${name}"/><origin xyz="${x} ${y} ${z}"/>
    </joint>
  </xacro:macro>

  <link name="base_link">
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.5 0.3 0.12"/></geometry>
      <material name="body"><color rgba="0.9 0.5 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><box size="0.5 0.3 0.12"/></geometry></collision>
    <inertial><origin xyz="0 0 0.0"/><mass value="8"/>
      <inertia ixx="0.1" iyy="0.2" izz="0.25" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <visual><geometry><cylinder radius="${wr}" length="0.04"/></geometry>
        <material name="tire"><color rgba="0.05 0.05 0.05 1"/></material></visual>
      <collision><geometry><cylinder radius="${wr}" length="0.04"/></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <inertial><mass value="0.6"/>
        <inertia ixx="0.0012" iyy="0.0012" izz="0.0019" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel"/>
      <origin xyz="0 ${y} 0" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>
  <xacro:wheel side="left" y="${ws/2}"/>
  <xacro:wheel side="right" y="${-ws/2}"/>

  <!-- Опоры без трения (шары) -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}">
      <collision><geometry><sphere radius="0.04"/></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <visual><geometry><sphere radius="0.04"/></geometry></visual>
      <inertial><mass value="0.1"/><inertia ixx="0.00007" iyy="0.00007" izz="0.00007" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/><child link="${name}"/><origin xyz="${x} 0 -0.04"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="caster_front" x="0.2"/>
  <xacro:caster name="caster_rear" x="-0.2"/>

  <xacro:small_link name="lidar_link" x="0" y="0" z="0.2"/>
  <xacro:small_link name="rgb_link" x="0.25" y="0.06" z="0.14"/>
  <xacro:small_link name="thermal_link" x="0.25" y="-0.06" z="0.14"/>
  <xacro:small_link name="imu_link" x="0" y="0" z="0.05"/>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>$(arg lidar_rate)</update_rate>
      <topic>/${ns}/lidar</topic>
      <gz_frame_id>${ns}/lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal><samples>$(arg lidar_samples)</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
          <vertical><samples>$(arg lidar_beams)</samples><min_angle>-0.26</min_angle><max_angle>0.26</max_angle></vertical>
        </scan>
        <range><min>0.1</min><max>30</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="rgb_link">
    <sensor name="rgb" type="camera">
      <always_on>1</always_on>
      <update_rate>$(arg rgb_rate)</update_rate>
      <topic>/${ns}/rgb/image_raw</topic>
      <gz_frame_id>${ns}/rgb_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>$(arg rgb_width)</width><height>$(arg rgb_height)</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>50</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="thermal_link">
    <sensor name="thermal" type="thermal">
      <always_on>1</always_on>
      <update_rate>$(arg thermal_rate)</update_rate>
      <topic>/${ns}/thermal/image_raw</topic>
      <gz_frame_id>${ns}/thermal_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>$(arg thermal_width)</width><height>$(arg thermal_height)</height><format>L16</format></image>
        <clip><near>0.1</near><far>50</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>$(arg imu_rate)</update_rate>
      <topic>/${ns}/imu</topic>
      <gz_frame_id>${ns}/imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${ws}</wheel_separation>
      <wheel_radius>${wr}</wheel_radius>
      <topic>/${ns}/cmd_vel</topic>
      <odom_topic>/${ns}/odom</odom_topic>
      <tf_topic>/${ns}/tf</tf_topic>
      <frame_id>${ns}/odom</frame_id>
      <child_frame_id>${ns}/base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>2</max_linear_acceleration>
      <max_angular_acceleration>4</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/${ns}/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
