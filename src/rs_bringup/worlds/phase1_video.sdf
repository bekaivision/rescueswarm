<?xml version="1.0" ?>
<!-- Мир Фазы 1 для видео: тот же мир, что phase1.sdf, плюс обзорная камера 1080x810@30 Гц,
     сохраняющая кадры (тег save). Кадры привязаны ко времени симуляции. Запуск: scripts/video/phase1.sh -->
<sdf version="1.9">
  <world name="phase1">
    <physics name="2ms" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <atmosphere type="adiabatic"><temperature>288.15</temperature></atmosphere>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.55 0.55 0.5 1</ambient><diffuse>0.55 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_red">
      <static>true</static>
      <pose>4 -1 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cylinder_blue">
      <static>true</static>
      <pose>5.5 1.2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.1 0.2 0.9 1</ambient><diffuse>0.1 0.2 0.9 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Нагретое тело (имитация человека), температура 310 K -->
    <model name="heat_source_1">
      <static>true</static>
      <pose>4.5 -2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><capsule><radius>0.2</radius><length>0.8</length></capsule></geometry></collision>
        <visual name="v"><geometry><capsule><radius>0.2</radius><length>0.8</length></capsule></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>310.0</temperature>
          </plugin>
        </visual>
      </link>
    </model>
    <model name="heat_source_2">
      <static>true</static>
      <pose>4 2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><capsule><radius>0.2</radius><length>0.8</length></capsule></geometry></collision>
        <visual name="v"><geometry><capsule><radius>0.2</radius><length>0.8</length></capsule></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>330.0</temperature>
          </plugin>
        </visual>
      </link>
    </model>
    <model name="wall_far">
      <static>true</static>
      <pose>10 0 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>14 0.2 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>14 0.2 2</size></box></geometry>
          <material><ambient>0.8 0.7 0.2 1</ambient><diffuse>0.8 0.7 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_side">
      <static>true</static>
      <pose>3 6 1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12 0.2 2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12 0.2 2</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="video_cam">
      <static>true</static>
      <pose>-2.5 -7.0 4.5 0 0.42 1.0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>0.95</horizontal_fov>
            <image><width>1080</width><height>810</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>60</far></clip>
            <save enabled="true"><path>/workspace/media/raw/phase-1/frames</path></save>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>video_cam</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
