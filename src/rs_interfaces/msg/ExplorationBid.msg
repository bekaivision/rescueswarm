# Ставки одного робота в децентрализованном аукционе исследования.
# Каждый робот публикует свои лучшие цели; все роботы по общей таблице ставок
# детерминированно считают одно и то же распределение.
std_msgs/Header header          # stamp = время симуляции, frame_id = world
string robot_id                 # например ground_1
uint32 seq                      # номер ставки (растёт на 1 при каждой публикации)
bool has_goal                   # робот сейчас едет к цели
geometry_msgs/Point current_goal  # текущая цель (валидна при has_goal)
geometry_msgs/Point[] targets   # центры кластеров фронтиров, на которые ставит робот (лучшие K)
float32[] costs                 # цены целей, та же длина; меньше = лучше
bool done                       # у робота не осталось достижимых фронтиров
string[] target_ids             # та же длина, что targets: id кандидата-человека для ставки на осмотр, '' для фронтира
uint32 open_candidates          # сколько кандидатов-людей робот считает открытыми (ещё нужен осмотр)
string[] gave_up                # кандидаты, от осмотра которых этот робот отказался (K неудач)
