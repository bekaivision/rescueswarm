<?xml version="1.0" ?>
<!-- Сцена для видео Фазы 0: тела падают и катятся, камера 1080x810@30 Гц сохраняет кадры (тег save).
     Кадры привязаны ко времени симуляции, поэтому скорость видео не зависит от ноутбука.
     Роботов нет. Запуск: scripts/video/phase0.sh -->
<sdf version="1.9">
  <world name="phase0_video">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.55 0.7 0.88 1</background>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.4 -0.9</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.45 0.5 0.45 1</ambient><diffuse>0.45 0.5 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp"><static>true</static><pose>0 0 1 0 0.2 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1.2 0.3</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1.2 0.3</size></box></geometry><material><ambient>0.85 0.75 0.25 1</ambient><diffuse>0.85 0.75 0.25 1</diffuse></material></visual></link></model>
    <model name="ball_red"><pose>-2.0 0 3.3 0 0 0</pose><link name="link"><inertial><mass>1</mass><inertia><ixx>0.0250</ixx><iyy>0.0250</iyy><izz>0.0250</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.25</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.25</radius></sphere></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="ball_green"><pose>-2.0 0.1 14.2 0 0 0</pose><link name="link"><inertial><mass>1</mass><inertia><ixx>0.0250</ixx><iyy>0.0250</iyy><izz>0.0250</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.25</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.25</radius></sphere></geometry><material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material></visual></link></model>
    <model name="ball_orange"><pose>-1.5 -0.1 178 0 0 0</pose><link name="link"><inertial><mass>1</mass><inertia><ixx>0.0360</ixx><iyy>0.0360</iyy><izz>0.0360</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.3</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.3</radius></sphere></geometry><material><ambient>0.95 0.55 0.1 1</ambient><diffuse>0.95 0.55 0.1 1</diffuse></material></visual></link></model>
    <model name="pyr_0"><pose>5.6 -0.45 0.2 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material></visual></link></model>
    <model name="pyr_1"><pose>5.6 0.0 0.2 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material></visual></link></model>
    <model name="pyr_2"><pose>5.6 0.45 0.2 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><ambient>0.95 0.5 0.1 1</ambient><diffuse>0.95 0.5 0.1 1</diffuse></material></visual></link></model>
    <model name="pyr_3"><pose>5.6 -0.225 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><ambient>0.2 0.7 0.8 1</ambient><diffuse>0.2 0.7 0.8 1</diffuse></material></visual></link></model>
    <model name="pyr_4"><pose>5.6 0.225 0.6 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><ambient>0.2 0.7 0.8 1</ambient><diffuse>0.2 0.7 0.8 1</diffuse></material></visual></link></model>
    <model name="pyr_5"><pose>5.6 0.0 1.0 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><ambient>0.9 0.9 0.2 1</ambient><diffuse>0.9 0.9 0.2 1</diffuse></material></visual></link></model>
    <model name="drop_blue"><pose>1.2 -1.5 33 0.3 0.4 0.2</pose><link name="link"><collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><ambient>0.2 0.5 0.95 1</ambient><diffuse>0.2 0.5 0.95 1</diffuse></material></visual></link></model>
    <model name="drop_yellow"><pose>3.2 -1.2 63 0.5 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry><material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual></link></model>
    <model name="drop_pink"><pose>4.5 1.0 113 0.1 0.2 0.5</pose><link name="link"><collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry><material><ambient>0.9 0.3 0.7 1</ambient><diffuse>0.9 0.3 0.7 1</diffuse></material></visual></link></model>
    <model name="drop_cyan"><pose>5.6 0 255 0.2 0.8 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.6</length></cylinder></geometry><material><ambient>0.2 0.8 0.85 1</ambient><diffuse>0.2 0.8 0.85 1</diffuse></material></visual></link></model>
    <model name="drop_purple"><pose>2.5 -0.2 346 0.2 0.1 0.3</pose><link name="link"><collision name="c"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 0.7 0.7</size></box></geometry><material><ambient>0.6 0.3 0.9 1</ambient><diffuse>0.6 0.3 0.9 1</diffuse></material></visual></link></model>
    <model name="video_cam">
      <static>true</static>
      <pose>2.0 -6.5 3.2 0 0.42 1.5708</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>1080</width><height>810</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>60</far></clip>
            <save enabled="true"><path>/workspace/media/raw/phase-0/frames</path></save>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>video_cam</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
